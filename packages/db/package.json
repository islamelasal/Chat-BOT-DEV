{
  "name": "@cbd/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./seed-kanz": {
      "types": "./dist/kanz.d.ts",
      "default": "./dist/kanz.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/schema.sql dist/schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cbd/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "pg": "^8.13.1",
    "@types/pg": "^8.23.1",
    "ioredis": "^6.0.0"
  },
  "type": "commonjs"
}
