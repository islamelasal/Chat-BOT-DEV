{
  "manifest_version": 3,
  "name": "Project Agent — وكيل المشروع",
  "version": "1.5.0",
  "minimum_chrome_version": "116",
  "description": "وكيل مشروع حديث يربط Arena AI ومحادثات AI المفتوحة بسياق المشاريع وأدوات المزودين المجانيين.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*"
  ],
  "action": {
    "default_title": "فتح وكيل المشروع"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-project-agent": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "فتح وكيل المشروع"
    }
  }
}
