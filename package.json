{
  "name": "chat-bot-dev",
  "version": "0.1.0",
  "private": true,
  "description": "Chat Bot Dev — منصة إدارة وتوزيع بوتات الذكاء الاصطناعي على مواقع العملاء",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "loadtest": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.10.12",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "fast-uri": "^3.1.6",
      "js-yaml": "^4.3.2",
      "qs": "^6.16.0"
    }
  }
}
