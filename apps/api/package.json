{
  "name": "@cbd/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build && node --input-type=commonjs -e \"fs.cpSync('public','dist/public',{recursive:true})\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker-main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx src/seed-run.ts"
  },
  "dependencies": {
    "@cbd/db": "workspace:*",
    "@cbd/gateway": "workspace:*",
    "@cbd/shared": "workspace:*",
    "@cbd/worker-core": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.2",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
