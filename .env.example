# ===== Chat Bot Dev — إعدادات البيئة =====
# انسخ إلى .env وعدّل القيم — لا تُرفع القيم الحقيقية إلى Git أبداً

# ── عام ──
NODE_ENV=development
PORT=4000

# ── قاعدة البيانات ──
# التطوير/الديمو: SQLite مدمج (صفر إعداد)
DATABASE_URL=file:./data/cbd.db
# الإنتاج: PostgreSQL
# DATABASE_URL=postgres://chatbotdev:STRONG_PASSWORD@localhost:5432/chatbotdev

# ── Redis (اختياري في التطوير — بدونه يعمل كاش ذاكرة) ──
# REDIS_URL=redis://localhost:6379

# ── أسرار التشفير (غيّرها في الإنتاج — 32+ حرفاً عشوائياً) ──
JWT_SECRET=change-me-32-chars-minimum-please!!
ENCRYPTION_KEY=change-me-encryption-32-chars!!

# ── الوضع ──
SEED_DEMO=true          # إنشاء بيانات العرض (أدمن + الشوا + مزودون)
WORKER_IN_PROCESS=true  # العامل داخل عملية الـ API (التطوير) — false في الإنتاج
DEMO_MODE=true          # سماح مفتوح بنطاقات الودجت (التطوير) — false في الإنتاج
RETENTION_DAYS=90
HEARTBEAT_INTERVAL_MS=30000

# ── الودجت ──
WIDGET_DIST=            # مسار بناء الودجت (افتراضياً يكتشف تلقائياً)
WIDGET_SCRIPT_URL=/w.js # الرابط في المقتطف (الإنتاج: https://widget.chatbotdev.app/w.js)

# ── CORS ──
CORS_ORIGINS=           # مفصولة بفواصل — فارغ = السماح للكل (تطوير)

# ── التنبيهات ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# ── لوحة التحكم (apps/dashboard) ──
# API_INTERNAL_URL=http://127.0.0.1:4000

# ── حدود المعدل ──
RATE_LIMIT_PER_IP_MIN=60
RATE_LIMIT_PER_SESSION_MIN=12
RATE_LIMIT_PER_CLIENT_HOUR=1000
RATE_LIMIT_DISABLED=false   # true فقط لاختبارات الحمل من IP واحد
